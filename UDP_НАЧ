#define _WINSOCK_DEPRECATED_NO_WARNINGS
#include <winsock2.h>
#include <stdio.h>
#pragma comment(lib, "ws2_32.lib")

int main()
{
    WSADATA wsa;
    WSAStartup(MAKEWORD(2, 2), &wsa);

    SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);

    sockaddr_in addr = {};
    addr.sin_family = AF_INET;
    addr.sin_port = htons(5000);
    addr.sin_addr.s_addr = INADDR_ANY;

    if (bind(s, (sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
        printf("bind error %d\n", WSAGetLastError());
        return 1;
    }

    printf("Server started on port 5000\n");

    while (true) {
        char buf[1024];
        sockaddr_in client = {};
        int clientLen = sizeof(client);

        int n = recvfrom(s, buf, sizeof(buf) - 1, 0, (sockaddr*)&client, &clientLen);
        if (n == SOCKET_ERROR) {
            printf("recvfrom error %d\n", WSAGetLastError());
            continue;
        }
        buf[n] = 0;

        printf("From %s:%d -> %s\n", inet_ntoa(client.sin_addr), ntohs(client.sin_port), buf);

        const char* reply = "OK, got it";
        sendto(s, reply, (int)strlen(reply), 0, (sockaddr*)&client, clientLen);
    }

    closesocket(s);
    WSACleanup();
    return 0;
}

#define _WINSOCK_DEPRECATED_NO_WARNINGS
#include <winsock2.h>
#include <stdio.h>
#pragma comment(lib, "ws2_32.lib")

int main()
{
    WSADATA wsa;
    WSAStartup(MAKEWORD(2, 2), &wsa);

    SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);

    sockaddr_in server = {};
    server.sin_family = AF_INET;
    server.sin_port = htons(5000);
    server.sin_addr.s_addr = inet_addr("127.0.0.1");   // IP сервера

    const char* msg = "Hello from client";
    sendto(s, msg, (int)strlen(msg), 0, (sockaddr*)&server, sizeof(server));
    printf("Sent: %s\n", msg);

    char buf[1024];
    sockaddr_in from = {};
    int fromLen = sizeof(from);

    int n = recvfrom(s, buf, sizeof(buf) - 1, 0, (sockaddr*)&from, &fromLen);
    if (n == SOCKET_ERROR) {
        printf("recvfrom error %d\n", WSAGetLastError());
    } else {
        buf[n] = 0;
        printf("Reply: %s\n", buf);
    }

    closesocket(s);
    WSACleanup();
    return 0;
}
