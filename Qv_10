void set(array *arr, int pos, int val) {
    if (arr == NULL) {
        printf("Error: cannot set value - array is NULL\n");
        return;
    }
    
    if (pos < 1 || pos > arr->size) {
        printf("segmentation fault (core dumped)");
        exit(-1);
    }
    
    arr->segment[pos-1] = val;
}
int get(array *arr, int pos) {
    if (arr == NULL) {
        printf("Error: cannot get value - array is NULL\n");
        return 0;
    }
    
    if (pos < 1 || pos > arr->size) {
        printf("segmentation fault (core dumped)");
        return exit(-1);
    }
    
    return arr->segment[pos-1];
}
void compact() {
    array *prev = allocated;
    array *nxt = prev->next;
    
    // проходим по всем выделенным массивам
    while (nxt->size != 0) {
        // копируем данные nxt сразу за prev
        for (int i = 0; i < nxt->size; i++) {
            // скопировать i-й элемент из текущего сегмента nxt
            // в новое место после prev
            prev->segment[prev->size + i] = nxt->segment[i];
        }
        
        // обновить указатель сегмента nxt
        // (он должен указывать на новое место после prev)
        nxt->segment = prev->segment + prev->size;
        
        // переход к следующему элементу
        prev = nxt;
        nxt = nxt->next;
    }
}
}
// Печатает текущее состояние списка выделенных массивов
void check() {
	const array* nxt = allocated;
	while (nxt != NULL) {
		printf(
			"array (%p): size %2d, segment %3d, next %14p \n",
			nxt,
			nxt->size,
			(int)(nxt->segment - memory),
			nxt->next
		);
		nxt = nxt->next;
	}
}
