#define MEMORY 100 // размер общей памяти (количество ячеек)
int memory[MEMORY]; // массив, моделирующий общую память
// структура, описывающая массив
typedef struct array {
	int size; // размер массива (сколько ячеек занимает)
	int* segment; // указатель на выделенный сегмент в общей памяти
	struct array* next; // указатель на следующий массив в списке
} array;
// фиктивный (граничный) элемент списка
// используется как "конец" списка размещённых массивов
array sentinel = {
0, // размер (не используется)
&memory[MEMORY], // указатель на "конец" памяти (за последним элементом)
NULL // дальше элементов нет
};
// фиктивный начальный элемент списка
// упрощает обработку граничных случаев при поиске свободного места
array dummy = {
1, // формальный размер (не важен)
&memory[-1], // указатель "перед началом" памяти
&sentinel // следующий элемент — sentinel
};
// указатель на начало списка выделенных массивов
array* allocated = &dummy;
array* allocate(int size) {
	array* nxt = allocated;
	while (nxt->next != NULL) {
		int free_space = (nxt->next->segment - (nxt->segment + nxt->size));
		if (free_space >= size) {
			// создать новый элемент array
			array* new = (array*)malloc(sizeof(array));
			if (new == NULL) return NULL;
			
			// TODO: инициализировать size
			new->size = size;
			
			// TODO: установить segment на свободное место между nxt и nxt->next
			new->segment = nxt->segment + nxt->size;
			
			// TODO: вставить новый элемент в связный список
			// TODO: обновить указатели next
			new->next = nxt->next;
			nxt->next = new;
			
			// TODO: вернуть созданный массив, если выделение успешно
			return new;
		}
		nxt = nxt->next;
	}
	return NULL; 
}
// Печатает текущее состояние списка выделенных массивов
void check() {
	const array* nxt = allocated;
	while (nxt != NULL) {
		printf(
			"array (%p): size %2d, segment %3d, next %14p \n",
			nxt,
			nxt->size,
			(int)(nxt->segment - memory),
			nxt->next
		);
		nxt = nxt->next;
	}
}
int main() {
	check();
	return 0;
}
