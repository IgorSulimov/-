#undef UNICODE
#define WIN32_LEAN_AND_MEAN
#define FD_SETSIZE 1024

#include <windows.h>
#include <winsock2.h>
#include <ws2tcpip.h>
#include <stdlib.h>
#include <stdio.h>
#include <vector>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <queue>
#include <string>

#pragma comment (lib, "Ws2_32.lib")

#define DEFAULT_BUFLEN 512
#define DEFAULT_PORT   "27015"
#define WORKER_COUNT   4

struct Task {
    SOCKET      client;
    std::string data;
};

std::queue<Task>          g_taskQueue;
std::mutex                g_queueMutex;
std::condition_variable   g_queueCV;
bool                      g_stop = false;


void Worker()
{
    while (true) {
        Task task;
        {
            std::unique_lock<std::mutex> lock(g_queueMutex);
            g_queueCV.wait(lock, [] { return g_stop || !g_taskQueue.empty(); });
            if (g_stop && g_taskQueue.empty()) return;
            task = std::move(g_taskQueue.front());
            g_taskQueue.pop();
        }

        printf("[worker %lu] handling %d bytes from client %llu\n",
            GetCurrentThreadId(), (int)task.data.size(),
            (unsigned long long)task.client);

        int sent = send(task.client, task.data.data(), (int)task.data.size(), 0);
        if (sent == SOCKET_ERROR) {
            int err = WSAGetLastError();
            if (err != WSAEWOULDBLOCK) {
                printf("[worker] send failed: %d\n", err);
            }
        }
    }
}


int __cdecl main(void)
{
    WSADATA wsaData;
    int iResult;

    SOCKET ListenSocket = INVALID_SOCKET;
    SOCKET ClientSocket = INVALID_SOCKET;

    struct addrinfo* result = NULL;
    struct addrinfo hints;

    // Мастер-множество сокетов для select (Содержит всех Клиентов)
    fd_set masterSet;
    // Отсылает готовых клиентов
    fd_set readSet;

    // --- Winsock init ---
    iResult = WSAStartup(MAKEWORD(2, 2), &wsaData);
    if (iResult != 0) {
        printf("WSAStartup failed: %d\n", iResult);
        return 1;
    }

    ZeroMemory(&hints, sizeof(hints));
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_protocol = IPPROTO_TCP;
    hints.ai_flags = AI_PASSIVE;

    iResult = getaddrinfo(NULL, DEFAULT_PORT, &hints, &result);
    if (iResult != 0) {
        printf("getaddrinfo failed: %d\n", iResult);
    }

    ListenSocket = socket(result->ai_family, result->ai_socktype, result->ai_protocol);
    if (ListenSocket == INVALID_SOCKET) {
        printf("socket failed: %ld\n", WSAGetLastError());
        freeaddrinfo(result);
    }

    iResult = bind(ListenSocket, result->ai_addr, (int)result->ai_addrlen);
    if (iResult == SOCKET_ERROR) {
        printf("bind failed: %d\n", WSAGetLastError());
        freeaddrinfo(result);
    }
    freeaddrinfo(result);

    iResult = listen(ListenSocket, SOMAXCONN);
    if (iResult == SOCKET_ERROR) {
        printf("listen failed: %d\n", WSAGetLastError());
    }

    // Инициализация мастер-множества
    FD_ZERO(&masterSet);
    FD_SET(ListenSocket, &masterSet);

    // Запускаем пул рабочих потоков
    std::vector<std::thread> workers;
    for (int i = 0; i < WORKER_COUNT; ++i) {
        workers.emplace_back(Worker);
    }

    // Поток цикл select
    while (true) {

        // select() модифицирует множество, поэтому каждый раз копируем
        readSet = masterSet;

        int ready = select(
            0,          // на Windows первый аргумент игнорируется
            &readSet,   // читаемые сокеты
            NULL,       // writable — не нужны
            NULL,       // exceptional — не нужны
            NULL        // ждать бесконечно, пока не будет события
        );

        if (ready == SOCKET_ERROR) {
            printf("select failed: %d\n", WSAGetLastError());
            break;
        }

        // Перебираем только те сокеты, которые готовы
        for (u_int i = 0; i < readSet.fd_count; i++) {
            SOCKET sock = readSet.fd_array[i];

            // Случай 1: новое подключение 
            if (sock == ListenSocket) {
                ClientSocket = accept(ListenSocket, NULL, NULL);
                if (ClientSocket == INVALID_SOCKET) {
                    int err = WSAGetLastError();
                    if (err != WSAEWOULDBLOCK)
                        printf("accept failed: %d\n", err);
                }
                else {
                    // Клиентский сокет оставляем неблокирующим:
                    // worker делает send, и неблокирующий send
                    // не застрянет, если буфер отправки полон.
                    u_long cm = 1;
                    ioctlsocket(ClientSocket, FIONBIO, &cm);

                    FD_SET(ClientSocket, &masterSet);
                    printf("new client %llu, total: %u\n",
                        (unsigned long long)ClientSocket,
                        (unsigned)masterSet.fd_count);
                }
            }
            // Случай 2: у существующего клиента есть данные
            else {
                char recvbuf[DEFAULT_BUFLEN];
                int r = recv(sock, recvbuf, DEFAULT_BUFLEN, 0);

                if (r > 0) {
                    {
                        std::lock_guard<std::mutex> lock(g_queueMutex);
                        g_taskQueue.push(Task{ sock, std::string(recvbuf, r) });
                    }
                    g_queueCV.notify_one();
                }
                else if (r == 0) {
                    printf("client %llu disconnected\n",
                        (unsigned long long)sock);
                    FD_CLR(sock, &masterSet);
                    closesocket(sock);
                }
                else {
                    int err = WSAGetLastError();
                    if (err != WSAEWOULDBLOCK) {
                        printf("recv failed on %llu: %d\n",
                            (unsigned long long)sock, err);
                        FD_CLR(sock, &masterSet);
                        closesocket(sock);
                    }
                }
            }
        }
    }
}
