#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>
#include <time.h>


typedef struct Node {
    char* data;
    struct Node* next;
} Node;


typedef struct {
    Node* head;
    Node* tail;
    int count;
} MyQueue;

void myqueue_init(MyQueue* q) {
    q->head = NULL;
    q->tail = NULL;
    q->count = 0;
}

void myqueue_push(MyQueue* q, const char* value) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->data = (char*)malloc(strlen(value) + 1);
    strcpy(newNode->data, value);
    newNode->next = NULL;

    if (q->tail) {
        q->tail->next = newNode;
        q->tail = newNode;
    }
    else {
        q->head = q->tail = newNode;
    }
    q->count++;
}

char* myqueue_pop(MyQueue* q) {
    if (!q->head) return NULL;

    Node* temp = q->head;
    char* value = temp->data;
    q->head = q->head->next;
    if (!q->head) q->tail = NULL;
    free(temp);
    q->count--;
    return value;
}

int myqueue_empty(MyQueue* q) {
    return q->head == NULL;
}

typedef struct {
    MyQueue queue;
    pthread_mutex_t mutex;
    sem_t sem;
} SafeQueue;

void safequeue_init(SafeQueue* sq) {
    myqueue_init(&sq->queue);
    pthread_mutex_init(&sq->mutex, NULL);
    sem_init(&sq->sem, 0, 0);
}

void safequeue_destroy(SafeQueue* sq) {
    pthread_mutex_destroy(&sq->mutex);
    sem_destroy(&sq->sem);
}

// Функция добавления задания в очередь
void enqueue_job(SafeQueue* sq, const char* task) {
    pthread_mutex_lock(&sq->mutex);     // захватываем мьютекс
    myqueue_push(&sq->queue, task);      // добавляем в очередь
    pthread_mutex_unlock(&sq->mutex);   // освобождаем мьютекс
    sem_post(&sq->sem);                  // сигнализируем, что задание появилось
}

// Функция извлечения задания из очереди
char* dequeue_job(SafeQueue* sq) {
    sem_wait(&sq->sem);                  // ждём, пока есть задание
    pthread_mutex_lock(&sq->mutex);      // захватываем мьютекс
    char* task = myqueue_pop(&sq->queue); // извлекаем из очереди
    pthread_mutex_unlock(&sq->mutex);    // освобождаем мьютекс
    return task;
}


SafeQueue g_queue;
FILE* g_file;
pthread_mutex_t g_file_mutex;
int g_running = 1;

void* worker_thread(void* arg) {
    int id = *(int*)arg;
    free(arg);

    printf("[Поток %d] Запущен\n", id);

    while (g_running) {
        char* task = dequeue_job(&g_queue);

        if (strcmp(task, "SHUTDOWN") == 0) {
            free(task);
            break;
        }

        printf("[Поток %d] Обрабатывает: %s\n", id, task);

        pthread_mutex_lock(&g_file_mutex);
        time_t now = time(NULL);
        char* time_str = ctime(&now);
        time_str[strlen(time_str) - 1] = '\0';
        fprintf(g_file, "[%s Поток %d] %s\n", time_str, id, task);
        fflush(g_file);
        pthread_mutex_unlock(&g_file_mutex);

        free(task);
    }

    printf("[Поток %d] Завершён\n", id);
    return NULL;
}

// ==================== MAIN ====================
int main() {
    int n_threads;
    char input[256];

    printf("Введите количество потоков: ");
    scanf("%d", &n_threads);
    getchar();

    g_file = fopen("output.log", "w");
    if (!g_file) {
        printf("Ошибка открытия файла\n");
        return 1;
    }

    safequeue_init(&g_queue);
    pthread_mutex_init(&g_file_mutex, NULL);

    pthread_t* threads = (pthread_t*)malloc(n_threads * sizeof(pthread_t));

    for (int i = 0; i < n_threads; i++) {
        int* id = (int*)malloc(sizeof(int));
        *id = i + 1;
        pthread_create(&threads[i], NULL, worker_thread, id);
    }

    printf("\nВведите строки (exit для выхода):\n");

    while (1) {
        printf("> ");
        fgets(input, sizeof(input), stdin);
        input[strcspn(input, "\n")] = '\0';

        if (strcmp(input, "exit") == 0) break;
        if (strlen(input) == 0) continue;

        enqueue_job(&g_queue, input);   // добавление задания в очередь
    }

    printf("\nЗавершение работы...\n");
    g_running = 0;

    for (int i = 0; i < n_threads; i++) {
        enqueue_job(&g_queue, "SHUTDOWN");
    }

    for (int i = 0; i < n_threads; i++) {
        pthread_join(threads[i], NULL);
    }

    fclose(g_file);
    pthread_mutex_destroy(&g_file_mutex);
    safequeue_destroy(&g_queue);
    free(threads);

    printf("Программа завершена\n");
    return 0;
}
